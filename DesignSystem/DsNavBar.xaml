<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DesignSystem.DsNavBar"
             x:Name="this"
             >
    <Grid RowDefinitions="56,*" RowSpacing="0">
        <Grid Grid.Row="0"
              BackgroundColor="#0038E5"
              ColumnDefinitions="56,*"
              Padding="0">
            <Button Grid.Column="0"
                    x:Name="ButtonElement"
                    Text="←"
                    BackgroundColor="Transparent"
                    Command="{Binding BackCommand, Source={x:Reference this}}"
                    TextColor="White"
                    FontSize="28"
                    FontAttributes="Bold"
                    BorderWidth="0"
                    Padding="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

            <Label Grid.Column="1"
                   Text="{Binding Title, Source={x:Reference this}}"
                   TextColor="White"
                   FontSize="16"
                   FontFamily="OpenSansBold"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   Margin="0,0,16,0" />
        </Grid>
    </Grid>
</ContentView>