<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ds="clr-namespace:DesignSystem"
             xmlns:converters="clr-namespace:DesignSystem.Converters"
             x:Class="DesignSystem.DsEntry"
             x:Name="this">
    
    <ContentView.Resources>
        <converters:EmptyStringColorConverter x:Key="ValidColorConverter" EmptyColor="#E0E0E0" NotEmptyColor="Red"/>
        <converters:NotEmptyStringToBoolConverter x:Key="ValidBoolConverter" Default="True"/>
    </ContentView.Resources>
             
    <VerticalStackLayout>
        <Border x:Name="InnerBorder"
                HeightRequest="56"
                Stroke="{Binding Error, Source={x:Reference this}, Converter={StaticResource ValidColorConverter}}"
                StrokeThickness="1"
                Background="Transparent"
                Padding="16"
                HorizontalOptions="Fill"
                >
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>

            <Entry x:Name="InnerEntry"
                   TextChanged="OnInternalTextChanged"
                   Placeholder="{Binding Placeholder, Source={x:Reference this}}"
                   IsPassword="{Binding IsPassword, Source={x:Reference this}}"
                   PlaceholderColor="#757575"
                   TextColor="Black"
                   FontFamily="OpenSansRegular"
                   FontSize="16"
                   VerticalOptions="Center"
                   Text="{Binding Text, Mode=TwoWay, Source={x:Reference this}}"
                   Keyboard="{Binding Keyboard, Source={x:Reference this}}" />
        </Border>

        <ds:DsLabelError x:Name="LabelError"
                         Text="{Binding Error, Source={x:Reference this}}"
                         Margin="16,4,16,0"
                         IsVisible="{Binding Error, Source={x:Reference this}, Converter={StaticResource ValidBoolConverter}}"
        />
    </VerticalStackLayout>
</ContentView>